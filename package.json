{
  "name": "@unravellingtechnologies/calendar-mcp-server",
  "version": "0.1.0",
  "description": "A TypeScript MCP server for managing calendar events via CalDAV",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "calendar-mcp-server": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "check": "pnpm run lint && pnpm run format:check",
    "clean": "rm -rf dist/*",
    "prebuild": "pnpm run clean",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "calendar",
    "caldav",
    "icloud",
    "typescript"
  ],
  "author": "Unravelling Technologies",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "commander": "^14.0.1",
    "ts-caldav": "^0.2.5",
    "zod": "^4.1.9"
  }
}
